---
// src/pages/[lang]/contact/index.astro
import MainLayout from '../../../layouts/MainLayout.astro';
import SEO from '../../../components/SEO.astro';
import ContactView from '../../../views/Contact/index.astro';
import { type Locale } from '../../../i18n/i18n';
import { getHeaderColors } from '../../../config/headerColors';
import { config } from '../../../i18n/config';
import { getPageBySlug } from '../../../services/api/pages';

export async function getStaticPaths() {
  return config.supportedLocales.map((locale) => ({
    params: { lang: locale },
    props: { currentLang: locale as Locale }
  }));
}

const { currentLang } = Astro.props;

const headerColorConfig = getHeaderColors('contact');
const page = await getPageBySlug('contact', currentLang);

const pageTitle = page?.metaTitle || page?.title || 'Contact - Yummi Nuts';
const pageDescription = page?.metaDescription || page?.excerpt || '';
const pageImage = page?.ogImage?.seoUrl ?? page?.ogImage?.originalUrl ?? '';
---

<MainLayout title={pageTitle}>
  <Fragment slot="head">
    <SEO
      currentLang={currentLang}
      title={page?.ogTitle || pageTitle}
      description={page?.ogDescription || pageDescription}
      canonicalUrl={`https://snacksyummies.com/${currentLang}/contact`}
      imageUrl={pageImage}
    />
  </Fragment>
  <ContactView currentLang={currentLang} headerColorConfig={headerColorConfig} />
</MainLayout>