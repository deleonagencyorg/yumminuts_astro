---
// src/pages/[lang]/recetas/[recipeId].astro
import { t, setLocale, type Locale } from '../../../i18n/i18n';
import MainLayout from '../../../layouts/MainLayout.astro';
import SEO from '../../../components/SEO.astro';
import RecipeDetail from '../../../views/Recipes/Detail/index.astro';
import { getAllRecipes } from '../../../services/api/recipes';
import { config } from '../../../i18n/config';
import SEO from '../../../components/SEO.astro';

export async function getStaticPaths() {
  const paths: any[] = [];
  const locale = 'es';
  // Cargar recetas desde archivos JSON con glob estático
  const modules = import.meta.glob('../../../locales/es/recipes/*.json', { eager: true });
  const files = Object.values(modules) as any[];
  console.log(`Encontradas ${files.length} recetas para idioma ${locale}`);
  for (const mod of files) {
    const recipe = (mod as any).default;
    if (!recipe?.id) continue;
    paths.push({
      params: { lang: locale, recipeId: recipe.id },
      props: { recipe, currentLang: locale }
    });
  }
  console.log(`Generadas ${paths.length} rutas de recetas en español`);
  return paths;
}

const { recipe, currentLang } = Astro.props;
const { lang, recipeId } = Astro.params;

// Establecer el idioma para las traducciones
setLocale(lang as Locale);

// seo desde cms
const pageTitle = recipe?.metaTitle || recipe?.title || 'Receta';
const pageDescription = recipe?.metaDescription || recipe?.description || '';
const pageImage = typeof recipe?.ogImage === 'string' 
  ? recipe.ogImage 
  : recipe?.ogImage?.url 
    ?? recipe?.image 
    ?? 'https://snack.yummiespromociones.com/snacksyummies/default-recipe.jpg';
---
<MainLayout title={recipe?.title || 'Receta'}>
  <Fragment slot="head">
    <SEO
      currentLang={currentLang}
      title={recipe?.title}
      description={recipe?.description || recipe?.title}
      canonicalUrl={`https://snacksyummies.com/${currentLang}/recetas/${recipeId}`}
      imageUrl={typeof recipe?.image === 'string'
        ? recipe.image
        : recipe?.image?.url ?? 'https://snack.yummiespromociones.com/snacksyummies/yumminuts-receta.webp'}
    />
  </Fragment>
  <RecipeDetail currentLang={currentLang} recipeId={recipeId} recipe={recipe} 
  />
</MainLayout>
