---
import { resolveStaticPath } from '../../../utils/staticPaths';
import JuradosView from '../../../views/Jurados/index.astro';
import { type Locale } from '../../../i18n/i18n';
import { getHeaderColors } from '../../../config/headerColors';

export async function getStaticPaths() {
  const locales = ['es'];
  return locales.map((locale) => ({
    params: { lang: locale },
    props: { currentLang: locale as Locale }
  }));
}

const staticPath = await resolveStaticPath(getStaticPaths, Astro.params);
if (!staticPath) {
  return Astro.rewrite('/404');
}

const { currentLang } = staticPath.props;

// Set header color config for contact page
const headerColorConfig = getHeaderColors('contact');
---

<JuradosView lang={currentLang} headerColor={headerColorConfig} />
