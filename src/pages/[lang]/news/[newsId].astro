---
// src/pages/[lang]/news/[newsId].astro
import { setLocale, type Locale } from '../../../i18n/i18n';
import MainLayout from '../../../layouts/MainLayout.astro';
import BlogDetail from '../../../views/Blog/Detail/index.astro';
import { config } from '../../../i18n/config';
import SEO from '../../../components/SEO.astro';
import { getAllNews } from '../../../services/api/news';

export async function getStaticPaths() {
  const locales = config.supportedLocales as Locale[];

  const allNewsByLang = await Promise.all(locales.map((lang) => getAllNews(lang)));

  return locales.flatMap((locale, index) =>
    allNewsByLang[index].map((blogPost) => ({
      params: { lang: locale, newsId: blogPost.slug },
      props: { blogPost, currentLang: locale },
    }))
  );
}

const { blogPost, currentLang } = Astro.props;
const { lang, newsId } = Astro.params;

setLocale(lang as Locale);
---

<MainLayout title={blogPost?.title || 'News'}>
  <Fragment slot="head">
    <SEO
      currentLang={currentLang}
      title={blogPost?.metaTitle || blogPost?.title}
      description={blogPost?.metaDescription || blogPost?.excerpt || blogPost?.description}
      canonicalUrl={`https://snacksyummies.com/${currentLang}/news/${newsId}`}
      imageUrl={typeof blogPost?.ogImage === 'string'
        ? blogPost.ogImage
        : blogPost?.ogImage?.url
          ?? (typeof blogPost?.image === 'string' ? blogPost.image : blogPost?.image?.url)
          ?? 'https://snack.yummiespromociones.com/snacksyummies/yumminuts-producto.webp'}
    />
  </Fragment>
  <BlogDetail blogPost={blogPost} currentLang={currentLang} />
</MainLayout>