---
import { resolveStaticPath } from '../../../utils/staticPaths';
import BlogDetail from '../../../views/Blog/Detail/index.astro';
import { type Locale } from '../../../i18n/i18n';
import { getAllNews } from '../../../services/api/news';

export async function getStaticPaths() {
  const locales = ['en', 'es'] as const;
  const paths = [];
  for (const locale of locales) {
    const news = await getAllNews(locale);
    const cmsPosts = news.map((item) => ({
      ...item,
      summary: item.excerpt,
      preview: item.image,
      banner: item.image,
      meta_title: item.title,
      meta_description: item.excerpt,
    }));
    const blogPosts = cmsPosts;
    for (const blogPost of blogPosts) {
      paths.push({
        params: {
          lang: locale,
          blogId: blogPost.slug || blogPost.id
        },
        props: {
          blogPost,
          currentLang: locale as Locale,
          allBlogPosts: blogPosts
        }
      });
    }
  }
  return paths;
}

const staticPath = await resolveStaticPath(getStaticPaths, Astro.params);
if (!staticPath) {
  return Astro.rewrite('/404');
}

const { blogPost, currentLang, allBlogPosts } = staticPath.props;
---

<BlogDetail blogPost={blogPost} currentLang={currentLang} allBlogPosts={allBlogPosts} />
