---
import { resolveStaticPath } from '../../../utils/staticPaths';
import BlogListing from '../../../views/Blog/index.astro';
import { type Locale } from '../../../i18n/i18n';
import { getAllNews } from '../../../services/api/news';

export async function getStaticPaths() {
  const locales = ['en', 'es'];
  return locales.map((locale) => ({
    params: { lang: locale },
    props: { currentLang: locale as Locale }
  }));
}

const staticPath = await resolveStaticPath(getStaticPaths, Astro.params);
if (!staticPath) {
  return Astro.rewrite('/404');
}

const { currentLang } = staticPath.props;
const news = await getAllNews(currentLang);
const blogPosts = news.map((item) => ({ ...item, summary: item.excerpt }));
---

<BlogListing blogPosts={blogPosts} currentLang={currentLang} />
