---
// src/components/common/InstagramReelsCarousel/InstagramReelsCarousel.astro
import InstagramEmbed from '../InstagramEmbed/index.astro';

export interface Props {
  posts: Array<{ url: string; alt?: string }>;
  className?: string;
}

const { posts = [], className = "" } = Astro.props;
---

<div class={`instagram-reels ${className}`}>
  <!-- Mobile carousel -->
  <div class="md:hidden relative w-full overflow-hidden">
    <button id="reels-prev" class="reels-arrow reels-arrow--prev">‹</button>
    <div id="reels-track" class="reels-track flex transition-transform duration-500 ease-out">
      {posts.map((post) => (
        <div class="reels-slide flex-shrink-0 w-full px-3">
          <div class="w-full overflow-hidden rounded-xl relative">
            <InstagramEmbed postUrl={post.url} alt={post.alt} />
          </div>
        </div>
      ))}
    </div>

    <button id="reels-next" class="reels-arrow reels-arrow--next"></button>
  </div>

  <!-- Desktop + Tablet: Mantener comportamiento original -->
  <div class="hidden md:block">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-1.5 sm:gap-2 md:gap-2 lg:gap-3">
      {posts.map((post) => (
        <div class="w-full overflow-hidden rounded-xl relative">
          <InstagramEmbed postUrl={post.url} alt={post.alt} />
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .reels-track {
    display: flex;
  }
  .reels-slide {
    flex: 0 0 100%;
    width: 100%;
  }

  .reels-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 30;
    background: rgba(255,255,255,0.95);
    color: #000;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    font-size: 28px;
    display: grid;
    place-items: center;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    border: none;
    cursor: pointer;
  }
  .reels-arrow--prev { left: 12px; }
  .reels-arrow--next { right: 12px; }
</style>

<script>
  function initMobileReels() {
    const track = document.getElementById('reels-track');
    const prev = document.getElementById('reels-prev');
    const next = document.getElementById('reels-next');

    if (!track || !prev || !next) return;

    let current = 0;
    const total = track.children.length;

    const goTo = (i) => {
      current = (i + total) % total;
      track.style.transform = `translateX(-${current * 100}%)`;
    };

    prev.addEventListener('click', () => goTo(current - 1));
    next.addEventListener('click', () => goTo(current + 1));

    // Swipe
    let startX = 0;
    track.addEventListener('touchstart', e => startX = e.touches[0].clientX, { passive: true });
    track.addEventListener('touchend', e => {
      const diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        goTo(diff > 0 ? current + 1 : current - 1);
      }
    }, { passive: true });
  }

  document.addEventListener('DOMContentLoaded', initMobileReels);
  document.addEventListener('astro:page-load', initMobileReels);
  document.addEventListener('astro:after-swap', initMobileReels);
</script>