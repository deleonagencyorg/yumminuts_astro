---
import LazyImage from './LazyImage.astro';

export interface Props {
  slide: {
    desktop?: string;
    mobile?: string;
    alt: string;
    title: string;
    subtitle: string;
    link?: string;
    description?: string;
    video?: string;
    type?: 'image' | 'video';
  };
  priority?: boolean;
  viewport?: 'mobile' | 'desktop';
  mobileLayout?: 'default' | 'horizontal';
}

const {
  slide,
  priority = false,
  viewport = 'desktop',
  mobileLayout = 'default',
} = Astro.props;

const desktopSrc = (slide.desktop || '').trim();
const mobileSrc = (slide.mobile || '').trim();
const videoSrc = (slide.video || '').trim();
const useHorizontalMobile = mobileLayout === 'horizontal';

// Determinar si es video
const isVideo = slide.type === 'video' || !!videoSrc;
const imageSrc = viewport === 'mobile'
  ? (useHorizontalMobile && desktopSrc ? desktopSrc : mobileSrc)
  : desktopSrc;

const finalSrc = isVideo ? videoSrc : imageSrc;

const imageClass = viewport === 'mobile'
  ? (useHorizontalMobile
    ? 'w-full h-full object-contain object-center'
    : 'w-full h-full object-cover object-center')
  : 'w-full h-full object-contain object-center';

const objectFit = viewport === 'mobile'
  ? (useHorizontalMobile ? 'contain' : 'cover')
  : 'contain';
const videoId = `video-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="swiper-slide relative h-full w-full">
  {isVideo && finalSrc ? (
    // Renderizar video
    <div class="w-full h-full overflow-hidden bg-black">
      <video
        id={videoId}
        src={finalSrc}
        class="w-full h-full object-cover object-center"
        muted
        loop
        playsinline
        preload="metadata"
        autoplay={viewport === 'desktop'}
        controls={false}
        data-carousel-video
        data-video-id={videoId}
        style="width: 100%; height: 100%; object-fit: cover; object-position: center;"
      >
        <track kind="captions" />
      </video>
    </div>
  ) : slide.link ? (
    <a href={slide.link} class="block w-full h-full">
      <div class="w-full h-full overflow-hidden">
        {finalSrc && (
          <LazyImage
            src={finalSrc}
            alt={slide.alt}
            class={imageClass}
            priority={priority}
            style={`width: 100%; height: 100%; object-fit: ${objectFit}; object-position: center;`}
          />
        )}
      </div>
      {(slide.title || slide.subtitle) && (
        <div class="absolute inset-x-0 bottom-8 flex flex-col items-center justify-center text-center text-white px-4">
          {slide.title && <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-2 md:mb-4 drop-shadow-lg">{slide.title}</h2>}
          {slide.subtitle && <p class="text-lg md:text-xl max-w-2xl drop-shadow">{slide.subtitle}</p>}
        </div>
      )}
    </a>
  ) : (
    <>
      <div class="w-full h-full overflow-hidden">
        {finalSrc && (
          <LazyImage
            src={finalSrc}
            alt={slide.alt}
            class={imageClass}
            priority={priority}
            style={`width: 100%; height: 100%; object-fit: ${objectFit}; object-position: center;`}
          />
        )}
      </div>
      {(slide.title || slide.subtitle) && (
        <div class="absolute inset-x-0 bottom-8 flex flex-col items-center justify-center text-center text-white px-4">
          {slide.title && <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-2 md:mb-4 drop-shadow-lg">{slide.title}</h2>}
          {slide.subtitle && <p class="text-lg md:text-xl max-w-2xl drop-shadow">{slide.subtitle}</p>}
        </div>
      )}
    </>
  )}
</div>

<script>
  // Control de reproducción de videos en el carousel
  function initCarouselVideos() {
    // Función para pausar todos los videos
    function pauseAllVideos(container: Element | null) {
      if (!container) return;
      const videos = container.querySelectorAll('video[data-carousel-video]');
      videos.forEach((video: Element) => {
        if (video instanceof HTMLVideoElement && !video.paused) {
          video.pause();
        }
      });
    }

    // Función para reproducir videos visibles
    function playVisibleVideos() {
      const slides = document.querySelectorAll('.swiper-slide');
      slides.forEach((slide: Element) => {
        const video = slide.querySelector('video[data-carousel-video]');
        if (!video) return;
        
        if (video instanceof HTMLVideoElement) {
          // Verificar si el slide está visible
          const isActive = slide.classList.contains('swiper-slide-active');
          const rect = slide.getBoundingClientRect();
          const isVisible = rect.top < window.innerHeight && rect.bottom > 0;
          
          if (isActive || isVisible) {
            const playPromise = video.play();
            if (playPromise && typeof playPromise.catch === 'function') {
              playPromise.catch((err: Error) => {
                console.log('Video play error:', err);
              });
            }
          } else {
            if (!video.paused) {
              video.pause();
            }
          }
        }
      });
    }

    // Intentar reproducir videos activos inmediatamente
    function tryPlayActiveVideos() {
      const activeSlides = document.querySelectorAll('.swiper-slide-active');
      activeSlides.forEach((slide: Element) => {
        const video = slide.querySelector('video[data-carousel-video]');
        if (video instanceof HTMLVideoElement) {
          const playPromise = video.play();
          if (playPromise && typeof playPromise.catch === 'function') {
            playPromise.catch((err: Error) => {
              console.log('Video play error:', err);
            });
          }
        }
      });
    }

    // Observar cambios en los slides
    const observer = new MutationObserver(() => {
      playVisibleVideos();
    });

    // Observar el contenedor del carousel
    const containers = document.querySelectorAll('.swiper-container');
    containers.forEach((container: Element) => {
      observer.observe(container, {
        attributes: true,
        attributeFilter: ['class'],
        subtree: true
      });
    });

    // Observer para visibilidad de slides
    const visibilityObserver = new IntersectionObserver((entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry: IntersectionObserverEntry) => {
        const video = entry.target.querySelector('video[data-carousel-video]');
        if (!video) return;
        
        if (video instanceof HTMLVideoElement) {
          if (entry.isIntersecting) {
            const playPromise = video.play();
            if (playPromise && typeof playPromise.catch === 'function') {
              playPromise.catch((err: Error) => {
                console.log('Video play error:', err);
              });
            }
          } else {
            if (!video.paused) {
              video.pause();
            }
          }
        }
      });
    }, { threshold: 0.3 });

    // Observar todos los slides con videos
    const allSlides = document.querySelectorAll('.swiper-slide');
    allSlides.forEach((slide: Element) => {
      if (slide.querySelector('video[data-carousel-video]')) {
        visibilityObserver.observe(slide);
      }
    });

    // Inicializar videos visibles
    setTimeout(() => {
      playVisibleVideos();
      tryPlayActiveVideos();
    }, 300);

    // Escuchar eventos de cambio de slide (Swiper)
    document.addEventListener('slideChange', () => {
      setTimeout(() => {
        playVisibleVideos();
        tryPlayActiveVideos();
      }, 100);
    });

    // También escuchar eventos personalizados del carousel
    document.addEventListener('swiper:slideChange', () => {
      setTimeout(() => {
        playVisibleVideos();
        tryPlayActiveVideos();
      }, 100);
    });

    // Forzar reproducción después de que Swiper termine la animación
    setTimeout(() => {
      tryPlayActiveVideos();
    }, 1000);

    // Escuchar clics en el carousel para reanudar videos
    const carouselContainers = document.querySelectorAll('.swiper-container');
    carouselContainers.forEach((container: Element) => {
      container.addEventListener('click', () => {
        setTimeout(tryPlayActiveVideos, 100);
      });
    });
  }

  // Inicializar cuando el DOM esté listo
  function initialize() {
    // Verificar si Swiper está disponible globalmente
    const swiperAvailable = typeof window !== 'undefined' && 
                           typeof (window as any).Swiper !== 'undefined';
    
    if (swiperAvailable) {
      setTimeout(initCarouselVideos, 200);
    } else {
      // Si Swiper no está disponible, esperar
      const checkSwiper = setInterval(() => {
        const isAvailable = typeof window !== 'undefined' && 
                           typeof (window as any).Swiper !== 'undefined';
        if (isAvailable) {
          clearInterval(checkSwiper);
          setTimeout(initCarouselVideos, 200);
        }
      }, 100);
      
      // Timeout para no esperar indefinidamente
      setTimeout(() => {
        clearInterval(checkSwiper);
        // Intentar inicializar de todas formas
        setTimeout(initCarouselVideos, 300);
      }, 5000);
    }
  }

  // Función para reinicializar videos después de navegación
  function reinitializeVideos() {
    // Limpiar videos existentes
    const videos = document.querySelectorAll('video[data-carousel-video]');
    videos.forEach((video: Element) => {
      if (video instanceof HTMLVideoElement) {
        video.pause();
        video.currentTime = 0;
      }
    });
    
    // Reinicializar
    setTimeout(initialize, 100);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize);
  } else {
    initialize();
  }

  // Reinicializar en navegaciones de Astro
  document.addEventListener('astro:page-load', reinitializeVideos);
  document.addEventListener('astro:after-swap', () => {
    setTimeout(reinitializeVideos, 200);
  });
</script>