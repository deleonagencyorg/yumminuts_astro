---
// Hybrid component combining Categories products display with Recipe-style filtering
import { getLocale } from '../../../i18n/i18n';
import ProductCard from '../ProductCard/index.astro';
import { getAllProducts } from '../../../services/api/products';
import { getProductCategories } from '../../../services/api/product-categories';

const currentLang = getLocale();
const products = await getAllProducts(currentLang);
const categories = await getProductCategories(currentLang);

export interface Props {
  title?: string;
  showAllProducts?: boolean;
}

const {
  title = currentLang === 'es' ? 'Nuestros Productos' : 'Our Products',
  showAllProducts = false
} = Astro.props;

const filterCategories = categories.map((c) => ({
  key: c.key,
  name: c.label,
  background: c.backgroundColor,
  slug: c.slug,
}));

function getProductCategory(product: any): string {
  const raw = String(product?.category || product?.title || product?.name || '').toLowerCase();
  // Try exact match against labels/slugs/keys
  for (const c of categories) {
    const label = String(c.label || '').toLowerCase();
    const slug = String(c.slug || '').toLowerCase();
    const key = String(c.key || '').toLowerCase();
    if (raw === label || raw === slug || raw === key) return c.key;
  }
  // Heuristics (fallback)
  const title = String(product?.title || '').toLowerCase();
  const id = String(product?.id || '').toLowerCase();
  const slug = String(product?.slug || '').toLowerCase();
  const category = String(product?.category || '').toLowerCase();
  if (title.includes('mani') || title.includes('maní') || id.includes('mani') || slug.includes('mani') ||
      title.includes('peanut') || category.includes('peanut')) return 'manies';
  if (title.includes('maranon') || title.includes('marañón') || id.includes('maranon') || slug.includes('maranon') ||
      title.includes('cashew') || category.includes('cashew')) return 'maranones';
  if (title.includes('semilla') || id.includes('semilla') || title.includes('seed') || category.includes('seed') ||
      title.includes('almond') || category.includes('almond') || title.includes('mix') || id.includes('mix')) return 'semillas';
  // Ultimate fallback
  return categories[0]?.key || 'manies';
}

// Display products (limit to 6 if not showing all)
const displayProducts = showAllProducts ? products : products.slice(0, 6);

const productRowGroups: string[][] = [
  ['manies'],
  ['maranones', 'semillas'],
  ['barras'],
];

function getProductTitle(product: any): string {
  return String(product?.title || product?.name || '');
}

function sortWithinCategory(items: any[]): any[] {
  return [...items].sort((a, b) => getProductTitle(a).localeCompare(getProductTitle(b), currentLang));
}

const groupedRows = productRowGroups
  .map((keys) => sortWithinCategory(
    displayProducts.filter((product) => keys.includes(getProductCategory(product)))
  ))
  .filter((row) => row.length > 0);

function slugify(input: string): string {
  return (input || '')
    .normalize('NFD')
    .replace(/\p{Diacritic}/gu, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

function productHref(product: any): string {
  const lang = currentLang === 'es' ? 'es' : 'en';
  const seg = currentLang === 'es' ? 'productos' : 'products';
  const slug = product?.slug || product?.id || slugify(product?.title || product?.name || '');
  return `/${lang}/${seg}/${slug}`;
}

---

<div class="w-full py-12 bg-white">
  <div class="container mx-auto px-4">
    
    <!-- Title -->
    <div class="text-left mb-8">
      <h2 class="font-heading text-4xl md:text-5xl font-extrabold text-black tracking-[-2px] leading-tight">
        {title}
      </h2>
    </div>

    <div class="mb-6 w-full">
      <select
        id="productsFilters"
        class="products-page-filter-select w-full text-left px-4 py-2 pr-10 rounded-md bg-secondary text-primary font-bold border border-white cursor-pointer"
        aria-label={currentLang === 'es' ? 'Filtrar productos' : 'Filter products'}
      >
        <option value="all">{currentLang === 'es' ? 'Todos los Productos' : 'All Products'}</option>
        {filterCategories.map((category) => (
          <option value={category.key}>{category.name}</option>
        ))}
      </select>
    </div>

    <div class="products-page-rows w-full" id="productsGrid">
      {groupedRows.map((rowProducts, rowIndex) => (
        <div class="products-page-row" data-row-index={rowIndex}>
          {rowProducts.map((product: any) => (
            <a href={productHref(product)} class="product-card group cursor-pointer block min-w-0" data-category={getProductCategory(product)}>
              <ProductCard
                title={getProductTitle(product)}
                image={typeof product.image === 'string' ? product.image : product.image?.url || '/images/products/placeholder.jpg'}
                bgColor={(product.backgroundColor || product.colorButton || filterCategories.find(c => c.key === getProductCategory(product))?.background || '#95CFF2')}
                description={product.description}
              />
            </a>
          ))}
        </div>
      ))}
    </div>

    <!-- No products message -->
    <div id="noProductsMessage" class={`text-center py-12 ${displayProducts.length === 0 ? '' : 'hidden'}`}>
      <p class="text-gray-500 text-lg">{currentLang === 'es' ? 'No hay productos disponibles en este momento.' : 'No products available at this time.'}</p>
    </div>

    <!-- Show All Button (if not showing all products) -->
    {!showAllProducts && products.length > 6 && (
      <div class="text-center mt-12">
        <a 
          href={`/${currentLang === 'es' ? 'es/productos' : 'en/products'}`}
          class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-full transition-colors duration-300 text-lg"
        >
          {currentLang === 'es' ? 'Ver Todos los Productos' : 'See All Products'}
        </a>
      </div>
    )}
  </div>
</div>

<style>
/* Filter button styles */
.products-page-filter-select {
  appearance: none;
  background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23385cad' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpath d='M19 9l-7 7-7-7'/%3e%3c/svg%3e");
  background-repeat: no-repeat;
  background-position: right 1rem center;
  background-size: 1.25rem;
}

.products-page-filter-select:focus {
  outline: none;
  box-shadow: 0 0 0 2px var(--color-brown, #8b4513);
}

/* Product card animations */
.product-card {
  opacity: 1;
  transform: scale(1);
  transition: all 0.3s ease;
}

.product-card.hidden {
  display: none !important;
}

.products-page-rows {
  --products-page-cols: 2;
  --products-page-gap: 1rem;
  display: flex;
  flex-direction: column;
  gap: calc(var(--products-page-gap) * 1.5);
}

.products-page-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: var(--products-page-gap);
}

.products-page-row.hidden-row { display: none !important; }

.products-page-row .product-card {
  width: calc((100% - (var(--products-page-cols) - 1) * var(--products-page-gap)) / var(--products-page-cols));
  max-width: calc((100% - (var(--products-page-cols) - 1) * var(--products-page-gap)) / var(--products-page-cols));
}

@media (min-width: 640px) {
  .products-page-rows { --products-page-gap: 1.5rem; }
}

@media (min-width: 1024px) {
  .products-page-rows { --products-page-cols: 4; --products-page-gap: 1.5rem; }
  .products-page-row .product-card { display: flex; justify-content: center; }
}

/* Text clamp utility */
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>

<script>
  function initProductsFilters() {
    const root = document.currentScript?.closest('.w-full')?.parentElement || document;
    const filtersEl = root.querySelector('#productsFilters');
    const gridEl = root.querySelector('#productsGrid');
    const noProductsMessage = root.querySelector('#noProductsMessage');

    if (!filtersEl || !gridEl) return;
    if ((filtersEl as any).dataset?.productsFiltersBound === '1') return;

    const productCards = Array.from(gridEl.querySelectorAll('.product-card'));

    if (!(filtersEl instanceof HTMLSelectElement) || !productCards.length) return;

    (filtersEl as any).dataset.productsFiltersBound = '1';

    function apply(category: string) {
      let visibleCount = 0;
      productCards.forEach((card) => {
        const productCategory = card.getAttribute('data-category');
        const shouldShow = category === 'all' || productCategory === category;
        card.classList.toggle('hidden', !shouldShow);
        if (shouldShow) visibleCount++;
      });
      if (noProductsMessage) {
        noProductsMessage.classList.toggle('hidden', visibleCount !== 0);
      }
    }

    filtersEl.addEventListener('change', () => apply(filtersEl.value || 'all'));

    // Initial state
    apply('all');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductsFilters);
  } else {
    initProductsFilters();
  }
  document.addEventListener('astro:page-load', initProductsFilters);
  document.addEventListener('astro:after-swap', initProductsFilters);
</script>