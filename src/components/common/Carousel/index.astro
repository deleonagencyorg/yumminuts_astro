---
import CarouselSlide from '../CarouselSlide.astro';
import Skeleton from './Skeleton.astro';
import './styles.css';

export interface Props {
  slides: Array<{
    desktop?: string;
    mobile?: string;
    alt: string;
    title: string;
    subtitle: string;
    link?: string;
  }>;
  loading?: boolean;
  /** `default`: slider vertical en móvil (home). `horizontal`: mantiene 16:9 en móvil (salud). */
  variant?: 'default' | 'horizontal';
}

// Coerce incoming slides to a safe array to avoid `.map` on non-arrays
const { slides: rawSlides, loading = false, variant = 'default' } = Astro.props as {
  slides?: any;
  loading?: boolean;
  variant?: 'default' | 'horizontal';
};
const slides = Array.isArray(rawSlides) ? rawSlides : [];
const hasMultipleSlides = slides.length > 1;
const isHorizontal = variant === 'horizontal';
const carouselClass = isHorizontal
  ? 'swiper-container main-carousel main-carousel--horizontal'
  : 'swiper-container main-carousel';

  const item = slide as Record<string, unknown>;
  const desktop = normalizeSlideImage(item.desktop);
  const mobile = normalizeSlideImage(item.mobile);

  return desktop !== '' || mobile !== '';
}

const slides = (Array.isArray(rawSlides) ? rawSlides : [])
  .filter(isValidCarouselSlide)
  .map((slide) => ({
    desktop: normalizeSlideImage(slide.desktop),
    mobile: normalizeSlideImage(slide.mobile),
    alt: slide.alt || 'Snacks Yummies',
    title: slide.title || '',
    subtitle: slide.subtitle || slide.description || '',
    link: slide.link || slide.url || '',
  }));

const isHorizontal = variant === 'horizontal';
const instanceId = `carousel-${Math.random().toString(36).slice(2)}`;

// Home: móvil solo slides con `mobile`. Desktop: slides con `desktop`.
// Salud (horizontal): en móvil también entran slides solo con desktop.
const mobileSlides = isHorizontal
  ? slides.filter((slide) => slide.mobile !== '' || slide.desktop !== '')
  : slides.filter((slide) => slide.mobile !== '');

const desktopSlides = slides.filter((slide) => slide.desktop !== '');

const mobileCarouselClass = isHorizontal
  ? 'swiper-container main-carousel main-carousel--horizontal js-main-carousel'
  : 'swiper-container main-carousel js-main-carousel';

const desktopCarouselClass = isHorizontal
  ? 'swiper-container main-carousel main-carousel--horizontal js-main-carousel'
  : 'swiper-container main-carousel js-main-carousel';

const firstMobileSlide = mobileSlides[0];
const firstDesktopSlide = desktopSlides[0];
---

<!-- Importar Swiper desde CDN para garantizar disponibilidad -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>

<!-- Cargar scripts del carrusel solo en el cliente -->
<script is:inline define:vars={{ carouselSelector: '.swiper-container.main-carousel', hasMultipleSlides }}>
  function initMainCarousel() {
    setTimeout(() => {
      try {
        if (!hasMultipleSlides || typeof Swiper === 'undefined') {
          return;
        }

        const container = document.querySelector(carouselSelector);
        if (!container) return;

        if (container.swiper) {
          container.swiper.destroy(true, true);
        }

        const swiper = new Swiper(carouselSelector, {
          loop: true,
          autoplay: {
            delay: 5000,
            disableOnInteraction: false,
            pauseOnMouseEnter: false,
          },
          navigation: {
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev',
          },
          pagination: {
            el: '.swiper-pagination',
            clickable: true,
          },
          touchRatio: 1.5,
          touchAngle: 45,
          touchMoveStopPropagation: true,
          touchStartPreventDefault: false,
          threshold: 5,
          simulateTouch: true,
          allowTouchMove: true,
        });

        window.addEventListener('load', () => swiper.update(), { once: true });

        window.addEventListener('orientationchange', () => {
          setTimeout(() => swiper.update(), 200);
        });
      } catch (error) {
        console.error('Error al inicializar Swiper:', error);
      }
    }, 300);
  }

  document.addEventListener('DOMContentLoaded', initMainCarousel);
  document.addEventListener('astro:page-load', initMainCarousel);
  document.addEventListener('astro:after-swap', initMainCarousel);
</script>

{loading ? (
  <Skeleton items={3} />
) : slides.length === 0 ? (
  <Skeleton items={1} />
) : (
  <div class={`relative overflow-hidden w-full mx-auto${isHorizontal ? ' carousel-horizontal' : ''}`} transition:animate="fade">
    {preloadFirstImage && (
      <>
        <!-- Precargar la primera imagen para dispositivos móviles -->
        <link rel="preload" href={isHorizontal ? firstSlide.desktop : firstSlide.mobile} as="image" media="(max-width: 767px)">
        <!-- Precargar la primera imagen para escritorio -->
        <link rel="preload" href={firstSlide.desktop} as="image" media="(min-width: 768px)">
      </>
    )}
    
    <!-- Swiper container -->
    <div class={carouselClass}>
      <div class="swiper-wrapper">
        {slides.map((slide, index) => (
          <CarouselSlide 
            slide={{
              desktop: slide.desktop,
              mobile: slide.mobile,
              alt: slide.alt || 'Snacks Yummies',
              title: slide.title || '',
              subtitle: slide.subtitle || '',
              link: slide.link || ''
            }}
            priority={index === 0}
            mobileLayout={isHorizontal ? 'horizontal' : 'default'}
          />
        ))}
      </div>
    )}
  </div>
)}
