---
import CarouselSlide from '../CarouselSlide.astro';
import Skeleton from './Skeleton.astro';
import './styles.css';

export interface Props {
  slides: Array<{
    desktop?: string;
    mobile?: string;
    alt: string;
    title: string;
    subtitle: string;
    link?: string;
  }>;
  loading?: boolean;
  /** `default`: slider vertical en móvil (home). `horizontal`: mantiene 16:9 en móvil (salud). */
  variant?: 'default' | 'horizontal';
  /** `full`: ancho completo (home). `contained`: dentro del container de página (productos, salud). */
  layout?: 'full' | 'contained';
}

const { slides: rawSlides, loading = false, variant = 'default', layout = 'full' } = Astro.props as {
  slides?: any;
  loading?: boolean;
  variant?: 'default' | 'horizontal';
  layout?: 'full' | 'contained';
};

function normalizeSlideImage(value: unknown): string {
  return typeof value === 'string' ? value.trim() : '';
}

function isValidCarouselSlide(slide: unknown): slide is {
  desktop?: string;
  mobile?: string;
  video?: string;
  type?: string;
  alt?: string;
  title?: string;
  subtitle?: string;
  description?: string;
  link?: string;
  url?: string;
} {
  if (!slide || typeof slide !== 'object') return false;

  const item = slide as Record<string, unknown>;
  const desktop = normalizeSlideImage(item.desktop);
  const mobile = normalizeSlideImage(item.mobile);
  const video = normalizeSlideImage(item.video);

  return desktop !== '' || mobile !== '' || video !== '';
}

const slides = (Array.isArray(rawSlides) ? rawSlides : [])
  .filter(isValidCarouselSlide)
  .map((slide) => ({
    desktop: normalizeSlideImage(slide.desktop) || normalizeSlideImage(slide.video),
    mobile: normalizeSlideImage(slide.mobile) || normalizeSlideImage(slide.video),
    video: normalizeSlideImage(slide.video),
    type: typeof slide.type === 'string' ? slide.type : '',
    alt: slide.alt || 'Snacks Yummies',
    title: slide.title || '',
    subtitle: slide.subtitle || slide.description || '',
    link: slide.link || slide.url || '',
  }));

const isHorizontal = variant === 'horizontal';
const instanceId = `carousel-${Math.random().toString(36).slice(2)}`;

// Home: móvil solo slides con `mobile`. Desktop: slides con `desktop`.
// Salud (horizontal): en móvil también entran slides solo con desktop.
const mobileSlides = isHorizontal
  ? slides.filter((slide) => slide.mobile !== '' || slide.desktop !== '')
  : slides.filter((slide) => slide.mobile !== '');

const desktopSlides = slides.filter((slide) => slide.desktop !== '');

const mobileCarouselClass = isHorizontal
  ? 'swiper-container main-carousel main-carousel--horizontal js-main-carousel'
  : 'swiper-container main-carousel js-main-carousel';

const desktopCarouselClass = isHorizontal
  ? 'swiper-container main-carousel main-carousel--horizontal js-main-carousel'
  : 'swiper-container main-carousel js-main-carousel';

const firstMobileSlide = mobileSlides[0];
const firstDesktopSlide = desktopSlides[0];

function isVideoUrl(value: string | undefined): boolean {
  return typeof value === 'string' && /\.(mp4|webm|ogg)(\?.*)?$/i.test(value);
}

const heroVideoUrl =
  [firstMobileSlide?.mobile, firstMobileSlide?.desktop, firstDesktopSlide?.desktop]
    .find((url) => isVideoUrl(url)) || '';
---

<!-- Importar Swiper desde CDN para garantizar disponibilidad -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>

<script is:inline>
  function isCarouselContainerVisible(container) {
    const parent = container.parentElement;
    if (!(parent instanceof HTMLElement)) return true;
    if (parent.offsetParent === null) return false;
    return getComputedStyle(parent).display !== 'none' && getComputedStyle(parent).visibility !== 'hidden';
  }

  function prepareCarouselVideo(video) {
    if (!(video instanceof HTMLVideoElement)) return;

    video.muted = true;
    video.defaultMuted = true;
    video.playsInline = true;
    video.setAttribute('muted', '');
    video.setAttribute('playsinline', '');
    video.setAttribute('webkit-playsinline', '');
    video.preload = 'auto';

    if (video.dataset.prepared === '1') return;
    video.dataset.prepared = '1';
    video.load();
  }

  function playCarouselVideo(video) {
    if (!(video instanceof HTMLVideoElement)) return;

    prepareCarouselVideo(video);

    const attemptPlay = () => {
      const playPromise = video.play();
      if (playPromise && typeof playPromise.catch === 'function') {
        playPromise.catch(() => {});
      }
    };

    if (video.readyState >= 2) {
      attemptPlay();
      return;
    }

    const onReady = () => {
      video.removeEventListener('canplaythrough', onReady);
      video.removeEventListener('canplay', onReady);
      video.removeEventListener('loadeddata', onReady);
      attemptPlay();
    };

    video.addEventListener('canplaythrough', onReady, { once: true });
    video.addEventListener('canplay', onReady, { once: true });
    video.addEventListener('loadeddata', onReady, { once: true });
    video.load();
  }

  function pauseCarouselVideos(root) {
    root.querySelectorAll('[data-carousel-video]').forEach((video) => {
      if (video instanceof HTMLVideoElement) {
        video.pause();
      }
    });
  }

  function preloadPriorityCarouselVideos(root) {
    root.querySelectorAll('[data-carousel-video-priority="true"]').forEach((video) => {
      prepareCarouselVideo(video);
    });
  }

  function playActiveCarouselVideo(root) {
    if (!isCarouselContainerVisible(root)) return;

    const activeVideo = root.querySelector('.swiper-slide-active [data-carousel-video]')
      || root.querySelector('[data-carousel-video-priority="true"]')
      || root.querySelector('[data-carousel-video]');

    if (!(activeVideo instanceof HTMLVideoElement)) return;
    playCarouselVideo(activeVideo);
  }

  function initCarouselVideoPreload() {
    document.querySelectorAll('[data-carousel-root]').forEach((root) => {
      root.querySelectorAll('.js-main-carousel').forEach((container) => {
        if (!(container instanceof HTMLElement)) return;
        if (!isCarouselContainerVisible(container)) return;
        preloadPriorityCarouselVideos(container);
        playActiveCarouselVideo(container);
      });
    });
  }

  function initMainCarousel() {
    const tryInit = (attempt = 0) => {
      try {
        if (typeof Swiper === 'undefined') {
          if (attempt < 10) {
            setTimeout(() => tryInit(attempt + 1), 200);
          }
          return;
        }

        document.querySelectorAll('[data-carousel-root]').forEach((root) => {
          const containers = root.querySelectorAll('.js-main-carousel');
          const useAutoHeight =
            root.classList.contains('carousel-contained') &&
            !root.classList.contains('carousel-horizontal');

          containers.forEach((container) => {
            if (!(container instanceof HTMLElement)) return;

            const slideCount = container.querySelectorAll('.swiper-slide').length;
            const nextEl = container.querySelector('.swiper-button-next');
            const prevEl = container.querySelector('.swiper-button-prev');
            const paginationEl = container.querySelector('.swiper-pagination');

            if (slideCount <= 1) {
              if (nextEl instanceof HTMLElement) nextEl.style.display = 'none';
              if (prevEl instanceof HTMLElement) prevEl.style.display = 'none';
              if (paginationEl instanceof HTMLElement) paginationEl.style.display = 'none';
              preloadPriorityCarouselVideos(container);
              playActiveCarouselVideo(container);
              return;
            }

            if (container.swiper) {
              container.swiper.destroy(true, true);
            }

            const swiper = new Swiper(container, {
              slidesPerView: 1,
              spaceBetween: 0,
              loop: slideCount > 1,
              autoHeight: useAutoHeight,
              observer: true,
              observeParents: true,
              autoplay: slideCount > 1 ? {
                delay: 5000,
                disableOnInteraction: false,
                pauseOnMouseEnter: false,
              } : false,
              navigation: {
                nextEl,
                prevEl,
              },
              pagination: {
                el: paginationEl,
                clickable: true,
              },
              touchRatio: 1,
              threshold: 8,
              simulateTouch: true,
              allowTouchMove: true,
              on: {
                init(swiperInstance) {
                  swiperInstance.update();
                  if (swiperInstance.autoplay) {
                    swiperInstance.autoplay.start();
                  }
                  playActiveCarouselVideo(swiperInstance.el);
                },
                slideChange(swiperInstance) {
                  pauseCarouselVideos(swiperInstance.el);
                  playActiveCarouselVideo(swiperInstance.el);
                },
              },
            });

            const refresh = () => {
              swiper.update();
              if (swiper.autoplay && !swiper.autoplay.running) {
                swiper.autoplay.start();
              }
            };

            window.addEventListener('load', refresh, { once: true });
            window.addEventListener('orientationchange', () => {
              setTimeout(refresh, 250);
            });

            const visibilityObserver = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  refresh();
                  if (swiper.autoplay) swiper.autoplay.start();
                  preloadPriorityCarouselVideos(container);
                  playActiveCarouselVideo(container);
                } else {
                  pauseCarouselVideos(container);
                }
              });
            }, { threshold: 0.2 });

            visibilityObserver.observe(container);
          });
        });
      } catch (error) {
        console.error('Error al inicializar Swiper:', error);
      }
    };

    setTimeout(() => tryInit(), 150);
  }

  initCarouselVideoPreload();
  document.addEventListener('DOMContentLoaded', initCarouselVideoPreload);
  document.addEventListener('DOMContentLoaded', initMainCarousel);
  document.addEventListener('astro:page-load', initCarouselVideoPreload);
  document.addEventListener('astro:page-load', initMainCarousel);
  document.addEventListener('astro:after-swap', initCarouselVideoPreload);
  document.addEventListener('astro:after-swap', initMainCarousel);
  window.addEventListener('pageshow', initCarouselVideoPreload);
  window.addEventListener('orientationchange', () => {
    setTimeout(initCarouselVideoPreload, 300);
  });
</script>

{heroVideoUrl && (
  <link rel="preload" href={heroVideoUrl} as="video" type="video/mp4" fetchpriority="high" />
)}

{loading ? (
  <Skeleton items={3} />
) : slides.length === 0 ? (
  <Skeleton items={1} />
) : (
  <div
    class={`relative overflow-hidden w-full mx-auto${isHorizontal ? ' carousel-horizontal' : ''}${layout === 'contained' ? ' carousel-contained' : ''}`}
    data-carousel-root={instanceId}
    transition:animate="fade"
  >
    {firstMobileSlide?.mobile && !/\.(mp4|webm|ogg)(\?.*)?$/i.test(firstMobileSlide.mobile) && (
      <link rel="preload" href={firstMobileSlide.mobile} as="image" media="(max-width: 767px)" />
    )}
    {firstMobileSlide?.mobile && /\.(mp4|webm|ogg)(\?.*)?$/i.test(firstMobileSlide.mobile) && (
      <link rel="preload" href={firstMobileSlide.mobile} as="video" type="video/mp4" media="(max-width: 767px)" fetchpriority="high" />
    )}
    {isHorizontal && firstMobileSlide?.desktop && !firstMobileSlide?.mobile && (
      <link rel="preload" href={firstMobileSlide.desktop} as="image" media="(max-width: 767px)" />
    )}
    {firstDesktopSlide?.desktop && !/\.(mp4|webm|ogg)(\?.*)?$/i.test(firstDesktopSlide.desktop) && (
      <link rel="preload" href={firstDesktopSlide.desktop} as="image" media="(min-width: 768px)" />
    )}
    {firstDesktopSlide?.desktop && /\.(mp4|webm|ogg)(\?.*)?$/i.test(firstDesktopSlide.desktop) && (
      <link rel="preload" href={firstDesktopSlide.desktop} as="video" type="video/mp4" media="(min-width: 768px)" fetchpriority="high" />
    )}

    {mobileSlides.length > 0 && (
      <div class="md:hidden">
        <div class={mobileCarouselClass}>
          <div class="swiper-wrapper">
            {mobileSlides.map((slide, index) => (
              <CarouselSlide
                slide={slide}
                priority={index === 0}
                viewport="mobile"
                mobileLayout={isHorizontal ? 'horizontal' : 'default'}
              />
            ))}
          </div>

          {mobileSlides.length > 1 && (
            <>
              <div class="swiper-button-next"></div>
              <div class="swiper-button-prev"></div>
              <div class="swiper-pagination"></div>
            </>
          )}
        </div>
      </div>
    )}

    {desktopSlides.length > 0 && (
      <div class={mobileSlides.length > 0 ? 'hidden md:block' : ''}>
        <div class={desktopCarouselClass}>
          <div class="swiper-wrapper">
            {desktopSlides.map((slide, index) => (
              <CarouselSlide
                slide={slide}
                priority={index === 0}
                viewport="desktop"
                mobileLayout={isHorizontal ? 'horizontal' : 'default'}
              />
            ))}
          </div>

          {desktopSlides.length > 1 && (
            <>
              <div class="swiper-button-next"></div>
              <div class="swiper-button-prev"></div>
              <div class="swiper-pagination"></div>
            </>
          )}
        </div>
      </div>
    )}
  </div>
)}
