---
import CarouselSlide from '../CarouselSlide.astro';
import Skeleton from './Skeleton.astro';
import './styles.css';

export interface Props {
  slides: Array<{
    desktop?: string;
    mobile?: string;
    alt: string;
    title: string;
    subtitle: string;
    link?: string;
    video?: string;
    type?: 'image' | 'video';
  }>;
  loading?: boolean;
  /** `default`: slider vertical en móvil (home). `horizontal`: mantiene 16:9 en móvil (salud). */
  variant?: 'default' | 'horizontal';
}

const { slides: rawSlides, loading = false, variant = 'default' } = Astro.props as {
  slides?: any;
  loading?: boolean;
  variant?: 'default' | 'horizontal';
};

function normalizeSlideImage(value: unknown): string {
  return typeof value === 'string' ? value.trim() : '';
}

function isValidCarouselSlide(slide: unknown): slide is {
  desktop?: string;
  mobile?: string;
  alt?: string;
  title?: string;
  subtitle?: string;
  description?: string;
  link?: string;
  url?: string;
  video?: string;
  type?: 'image' | 'video';
} {
  if (!slide || typeof slide !== 'object') return false;

  const item = slide as Record<string, unknown>;
  const desktop = normalizeSlideImage(item.desktop);
  const mobile = normalizeSlideImage(item.mobile);
  const video = normalizeSlideImage(item.video);

  // Validar que tenga al menos una imagen o video
  return desktop !== '' || mobile !== '' || video !== '';
}

const slides = (Array.isArray(rawSlides) ? rawSlides : [])
  .filter(isValidCarouselSlide)
  .map((slide) => ({
    desktop: normalizeSlideImage(slide.desktop),
    mobile: normalizeSlideImage(slide.mobile),
    alt: slide.alt || 'Snacks Yummies',
    title: slide.title || '',
    subtitle: slide.subtitle || slide.description || '',
    link: slide.link || slide.url || '',
    video: normalizeSlideImage(slide.video),
    // Detectar automáticamente si es video
    type: slide.type || (slide.video ? 'video' : 'image'),
  }));

const isHorizontal = variant === 'horizontal';
const instanceId = `carousel-${Math.random().toString(36).slice(2)}`;

// Home: móvil solo slides con `mobile`. Desktop: slides con `desktop`.
// Salud (horizontal): en móvil también entran slides solo con desktop.
const mobileSlides = isHorizontal
  ? slides.filter((slide) => slide.mobile !== '' || slide.desktop !== '')
  : slides.filter((slide) => slide.mobile !== '');

const desktopSlides = slides.filter((slide) => slide.desktop !== '');

const mobileCarouselClass = isHorizontal
  ? 'swiper-container main-carousel main-carousel--horizontal js-main-carousel'
  : 'swiper-container main-carousel js-main-carousel';

const desktopCarouselClass = isHorizontal
  ? 'swiper-container main-carousel main-carousel--horizontal js-main-carousel'
  : 'swiper-container main-carousel js-main-carousel';

const firstMobileSlide = mobileSlides[0];
const firstDesktopSlide = desktopSlides[0];
---

<!-- Importar Swiper desde CDN para garantizar disponibilidad -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />
<script is:inline src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>

<script is:inline>
  function initMainCarousel() {
    const tryInit = (attempt = 0) => {
      try {
        if (typeof Swiper === 'undefined') {
          if (attempt < 10) {
            setTimeout(() => tryInit(attempt + 1), 200);
          }
          return;
        }

        document.querySelectorAll('[data-carousel-root]').forEach((root) => {
          const containers = root.querySelectorAll('.js-main-carousel');

          containers.forEach((container) => {
            if (!(container instanceof HTMLElement)) return;

            const slideCount = container.querySelectorAll('.swiper-slide').length;
            const nextEl = container.querySelector('.swiper-button-next');
            const prevEl = container.querySelector('.swiper-button-prev');
            const paginationEl = container.querySelector('.swiper-pagination');

            if (slideCount <= 1) {
              if (nextEl instanceof HTMLElement) nextEl.style.display = 'none';
              if (prevEl instanceof HTMLElement) prevEl.style.display = 'none';
              if (paginationEl instanceof HTMLElement) paginationEl.style.display = 'none';
              return;
            }

            if (container.swiper) {
              container.swiper.destroy(true, true);
            }

            const swiper = new Swiper(container, {
              slidesPerView: 1,
              spaceBetween: 0,
              loop: slideCount > 1,
              observer: true,
              observeParents: true,
              autoplay: slideCount > 1 ? {
                delay: 5000,
                disableOnInteraction: false,
                pauseOnMouseEnter: false,
              } : false,
              navigation: {
                nextEl,
                prevEl,
              },
              pagination: {
                el: paginationEl,
                clickable: true,
              },
              touchRatio: 1,
              threshold: 8,
              simulateTouch: true,
              allowTouchMove: true,
              on: {
                init(swiperInstance) {
                  swiperInstance.update();
                  if (swiperInstance.autoplay) {
                    swiperInstance.autoplay.start();
                  }
                  // Disparar eventos para videos
                  document.dispatchEvent(new CustomEvent('slideChange'));
                  document.dispatchEvent(new CustomEvent('swiper:slideChange'));
                  // Forzar reproducción de videos después de init
                  setTimeout(() => {
                    document.dispatchEvent(new CustomEvent('slideChange'));
                    document.dispatchEvent(new CustomEvent('swiper:slideChange'));
                  }, 500);
                },
                slideChange(swiperInstance) {
                  // Disparar eventos para videos
                  document.dispatchEvent(new CustomEvent('slideChange'));
                  document.dispatchEvent(new CustomEvent('swiper:slideChange'));
                  // Pausar videos al cambiar
                  pauseAllVideos(container);
                  // Forzar reproducción después del cambio
                  setTimeout(() => {
                    document.dispatchEvent(new CustomEvent('slideChange'));
                    document.dispatchEvent(new CustomEvent('swiper:slideChange'));
                  }, 300);
                },
                slideChangeTransitionEnd(swiperInstance) {
                  // Disparar eventos al finalizar la transición
                  document.dispatchEvent(new CustomEvent('slideChange'));
                  document.dispatchEvent(new CustomEvent('swiper:slideChange'));
                },
              },
            });

            // Función para pausar todos los videos en el contenedor
            function pauseAllVideos(container) {
              const videos = container.querySelectorAll('video[data-carousel-video]');
              videos.forEach((video) => {
                if (video instanceof HTMLVideoElement && !video.paused) {
                  video.pause();
                }
              });
            }

            // Función para pausar videos cuando el carousel no está visible
            function handleVisibilityChange() {
              const isVisible = container.offsetParent !== null;
              if (!isVisible) {
                pauseAllVideos(container);
              }
            }

            // Observer para visibilidad del contenedor
            const visibilityObserver = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) {
                  pauseAllVideos(container);
                }
              });
            }, { threshold: 0 });

            visibilityObserver.observe(container);

            // Observer para cambios de visibilidad de página
            document.addEventListener('visibilitychange', () => {
              if (document.hidden) {
                pauseAllVideos(container);
              }
            });

            const refresh = () => {
              swiper.update();
              if (swiper.autoplay && !swiper.autoplay.running) {
                swiper.autoplay.start();
              }
            };

            window.addEventListener('load', refresh, { once: true });
            window.addEventListener('orientationchange', () => {
              setTimeout(refresh, 250);
            });
          });
        });
      } catch (error) {
        console.error('Error al inicializar Swiper:', error);
      }
    };

    setTimeout(() => tryInit(), 150);
  }

  document.addEventListener('DOMContentLoaded', initMainCarousel);
  document.addEventListener('astro:page-load', initMainCarousel);
  document.addEventListener('astro:after-swap', () => {
    setTimeout(initMainCarousel, 200);
  });
</script>

{loading ? (
  <Skeleton items={3} />
) : slides.length === 0 ? (
  <Skeleton items={1} />
) : (
  <div
    class={`relative overflow-hidden w-full mx-auto${isHorizontal ? ' carousel-horizontal' : ''}`}
    data-carousel-root={instanceId}
    transition:animate="fade"
  >
    {firstMobileSlide?.mobile && (
      <link rel="preload" href={firstMobileSlide.mobile} as="image" media="(max-width: 767px)" />
    )}
    {isHorizontal && firstMobileSlide?.desktop && !firstMobileSlide?.mobile && (
      <link rel="preload" href={firstMobileSlide.desktop} as="image" media="(max-width: 767px)" />
    )}
    {firstDesktopSlide?.desktop && (
      <link rel="preload" href={firstDesktopSlide.desktop} as="image" media="(min-width: 768px)" />
    )}

    {mobileSlides.length > 0 && (
      <div class="md:hidden">
        <div class={mobileCarouselClass}>
          <div class="swiper-wrapper">
            {mobileSlides.map((slide, index) => (
              <CarouselSlide
                slide={slide}
                priority={index === 0}
                viewport="mobile"
                mobileLayout={isHorizontal ? 'horizontal' : 'default'}
              />
            ))}
          </div>

          {mobileSlides.length > 1 && (
            <>
              <div class="swiper-button-next !text-white !bg-black/30 !w-12 !h-12 !rounded-full hover:!bg-black/50 transition-all"></div>
              <div class="swiper-button-prev !text-white !bg-black/30 !w-12 !h-12 !rounded-full hover:!bg-black/50 transition-all"></div>
              <div class="swiper-pagination !bottom-4"></div>
            </>
          )}
        </div>
      </div>
    )}

    {desktopSlides.length > 0 && (
      <div class={mobileSlides.length > 0 ? 'hidden md:block' : ''}>
        <div class={desktopCarouselClass}>
          <div class="swiper-wrapper">
            {desktopSlides.map((slide, index) => (
              <CarouselSlide
                slide={slide}
                priority={index === 0}
                viewport="desktop"
                mobileLayout={isHorizontal ? 'horizontal' : 'default'}
              />
            ))}
          </div>

          {desktopSlides.length > 1 && (
            <>
              <div class="swiper-button-next !text-white !bg-black/30 !w-12 !h-12 !rounded-full hover:!bg-black/50 transition-all"></div>
              <div class="swiper-button-prev !text-white !bg-black/30 !w-12 !h-12 !rounded-full hover:!bg-black/50 transition-all"></div>
              <div class="swiper-pagination !bottom-4"></div>
            </>
          )}
        </div>
      </div>
    )}
  </div>
)}
