---
import { getLocale } from '../../i18n/i18n';
import LazyImage from '../common/LazyImage.astro';
import { getHealthIcons } from '../../services/api/sections';

const locale = getLocale();
const healthIcons = await getHealthIcons(locale);
---

<section class="w-full py-12 bg-white">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {healthIcons.map((item) => (
        <div class="flex justify-center">
          <LazyImage
            src={item.imageUrl}
            alt={item.title}
            class="w-24 h-24 md:w-32 md:h-32 object-contain"
          />
        </div>
      ))}
    </div>
  </div>
</section>
