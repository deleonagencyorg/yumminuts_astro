---
import ProductCard from '../ProductCard/index.astro';
import { getLocale } from '../../../i18n/i18n';
import categoriesConfig from '../../../config/categories.json';

export interface HomeProduct {
  id: string;
  title: string;
  image: string;
  bgColor: string;
  slug?: string;
  categoryKey?: string;
}

export interface Props {
  products: HomeProduct[];
  title?: string;
}

const currentLang = getLocale();
const {
  products = [],
  title = currentLang === 'es' ? 'Nuestros Productos' : 'Our Products',
} = Astro.props;

const homeRowGroups: string[][] = [
  ['manies'],
  ['maranones', 'semillas'],
  ['barras'],
];

function sortWithinCategory(products: HomeProduct[]): HomeProduct[] {
  return [...products].sort((a, b) => a.title.localeCompare(b.title, currentLang));
}

const groupedRowsWithKeys = homeRowGroups
  .map((keys) => {
    const items = sortWithinCategory(
      products.filter((product) => keys.includes(product.categoryKey || ''))
    );
    return { key: keys[0], items };
  })
  .filter((pair) => pair.items.length > 0);

const groupedRows = groupedRowsWithKeys.map((p) => p.items);
const groupedRowKeys = groupedRowsWithKeys.map((p) => p.key);

const sortedProducts = groupedRows.flat();

const productsSegment = currentLang === 'es' ? 'productos' : 'products';
const langPrefix = currentLang === 'es' ? 'es' : 'en';
const loadMoreLabel = currentLang === 'es' ? 'Cargar más' : 'Load more';
const allProductsLabel = currentLang === 'es' ? 'Todos' : 'All Products';
const filterAriaLabel = currentLang === 'es' ? 'Filtrar productos' : 'Filter products';
const filterOptions = [
  { key: 'all', label: allProductsLabel },
  ...(categoriesConfig.categories || []).map((category) => ({
    key: category.key,
    label: currentLang === 'es' ? category.labels.es : category.labels.en,
  })),
];
const instanceId = `home-products-${Math.random().toString(36).slice(2)}`;

function productHref(product: HomeProduct): string {
  return `/${langPrefix}/${productsSegment}/${product.slug || product.id}`;
}
---

{sortedProducts.length > 0 && (
  <div class="w-full" data-home-products-grid={instanceId} data-total-products={sortedProducts.length}>
    <div class="text-left mb-10 md:mb-16 relative z-20" data-reveal-child>
      <h2 class="font-heading leading-none not-italic text-black text-4xl md:text-6xl tracking-tight text-left">
        {title}
      </h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8" role="group" aria-label={filterAriaLabel}>
      {filterOptions.map((option) => (
        <button
          type="button"
          class="filter-btn w-full text-center px-6 py-2 rounded-md bg-secondary text-primary font-bold hover:text-primary hover:bg-secondary hover:opacity-100 active:text-primary active:bg-secondary transition-colors border border-white"
          data-filter={option.key}
        >
          {option.label}
        </button>
      ))}
    </div>

    <div
      id={`${instanceId}-grid`}
      class="home-products-rows w-full"
    >
      {groupedRows.map((rowProducts, rowIndex) => (
        <div class="home-products-row" data-row-index={rowIndex} data-row-key={groupedRowKeys[rowIndex]}>
          {rowProducts.map((product, index) => (
            <a
              href={productHref(product)}
              class="home-product-card block w-full min-w-0"
              data-category={product.categoryKey || ''}
              data-row={rowIndex}
              data-index={index}
            >
              <ProductCard
                title={product.title}
                image={product.image}
                bgColor={product.bgColor}
              />
            </a>
          ))}
        </div>
      ))}
    </div>

    {sortedProducts.length > 0 && (
      <div class="mt-8 w-full home-products-load-more-wrap hidden">
        <button
          type="button"
          class="js-home-products-load-more filter-btn w-full text-center px-4 py-3 rounded-md bg-secondary text-primary font-bold hover:text-primary hover:bg-secondary hover:opacity-100 transition-colors border border-white"
          data-mobile-batch="1"
          data-desktop-batch="1"
        >
          {loadMoreLabel}
        </button>
      </div>
    )}
  </div>
)}

<style>
  .home-products-rows {
    --home-products-cols: 2;
    --home-products-gap: 1rem;
    display: flex;
    flex-direction: column;
    gap: calc(var(--home-products-gap) * 1.5);
    width: 100%;
  }

  .home-products-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--home-products-gap);
    width: 100%;
  }

    .home-products-row[data-row-key="barras"] {
      margin-top: 2.5rem;
    }

  .home-products-row.hidden-row,
  .home-product-card.hidden {
    display: none !important;
  }

  .home-products-row .home-product-card {
    width: calc((100% - (var(--home-products-cols) - 1) * var(--home-products-gap)) / var(--home-products-cols));
    max-width: calc((100% - (var(--home-products-cols) - 1) * var(--home-products-gap)) / var(--home-products-cols));
    min-width: 0;
  }

  @media (min-width: 640px) {
    .home-products-rows {
      --home-products-gap: 1.5rem;
    }
  }

  @media (max-width: 1023px) {
    .home-products-row .home-product-card :global(.font-sans) {
      font-size: 1.25rem;
      line-height: 1.75rem;
    }
  }

  @media (min-width: 1024px) {
    .home-products-rows {
      --home-products-cols: 4;
      --home-products-gap: 1.5rem;
    }

    .home-products-row .home-product-card {
      display: flex;
      justify-content: center;
    }

    .home-products-row .home-product-card :global(.group) {
      width: 100%;
      max-width: 100%;
    }

    .home-products-row .home-product-card :global(.font-sans) {
      font-size: 1.3rem;
      line-height: 2rem;
    }
  }
</style>

<script define:vars={{ instanceId, totalRows: groupedRows.length }}>
  function initHomeProductsGrid(instanceId, totalRows) {
    const root = document.querySelector(`[data-home-products-grid="${instanceId}"]`);
    if (!(root instanceof HTMLElement)) return;
    if (root.dataset.homeProductsInit === 'true') return;
    root.dataset.homeProductsInit = 'true';

    const rowsContainer = root.querySelector('.home-products-rows');
    const loadMoreWrap = root.querySelector('.home-products-load-more-wrap');
    const loadMoreBtn = root.querySelector('.js-home-products-load-more');
    const filterButtons = Array.from(root.querySelectorAll('[data-filter]'));
    if (!(rowsContainer instanceof HTMLElement)) return;

    const allRows = () => Array.from(rowsContainer.querySelectorAll('.home-products-row'));
    const isMobile = () => window.matchMedia('(max-width: 1023px)').matches;
    const rowBatch = loadMoreBtn instanceof HTMLButtonElement
      ? Number(loadMoreBtn.dataset.desktopBatch) || 1
      : 1;

    let activeFilter = 'all';
    let visibleRows = Math.min(rowBatch, Math.max(allRows().length, totalRows));

    const updateVisible = () => {
      const rows = allRows();
      const filtering = activeFilter !== 'all';
      const paginate = !filtering && !isMobile();
      visibleRows = Math.min(visibleRows, rows.length);

      rows.forEach((row, index) => {
        const cards = Array.from(row.querySelectorAll('.home-product-card'));
        let visible = 0;
        cards.forEach((card) => {
          const show = !filtering || card.getAttribute('data-category') === activeFilter;
          card.classList.toggle('hidden', !show);
          if (show) visible += 1;
        });
        row.classList.toggle('hidden-row', visible === 0 || (paginate && index >= visibleRows));
      });

      const hasMore = paginate && visibleRows < rows.length;
      if (loadMoreWrap instanceof HTMLElement) {
        loadMoreWrap.classList.toggle('hidden', !hasMore);
      }
    };

    const setActiveButton = (filter) => {
      filterButtons.forEach((btn) => {
        btn.classList.remove('bg-secondary', 'opacity-40', 'opacity-50', 'text-primary');
        btn.classList.add('text-primary');
      });
      const activeBtn = filterButtons.find((btn) => btn.getAttribute('data-filter') === filter);
      if (activeBtn) activeBtn.classList.add('bg-secondary', 'text-primary');
      filterButtons.forEach((btn) => {
        if (btn !== activeBtn) btn.classList.add('opacity-40');
      });
    };

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeFilter = btn.getAttribute('data-filter') || 'all';
        setActiveButton(activeFilter);
        updateVisible();
      });
    });

    setActiveButton(activeFilter);

    if (loadMoreBtn instanceof HTMLButtonElement) {
      loadMoreBtn.addEventListener('click', () => {
        visibleRows = Math.min(visibleRows + rowBatch, allRows().length);
        updateVisible();
      });
    }

    updateVisible();
  }

  function setup() {
    initHomeProductsGrid(instanceId, totalRows);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else {
    setup();
  }
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:after-swap', setup);
</script>
