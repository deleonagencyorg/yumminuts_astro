---
import type { Locale } from '../i18n/i18n';
import config from '../i18n/config';
import { getSiteTexts, text } from '../services/api/site-texts';
import { getSocialMediaLinks } from '../services/api/social-media';

export interface Props {
  currentLang: Locale;
  title?: string;
  description?: string;
  canonicalUrl?: string;
  imageUrl?: string;
}

const { currentLang, title, description, canonicalUrl, imageUrl } = Astro.props;

const siteTexts = await getSiteTexts(currentLang);
const socialMedia = await getSocialMediaLinks(currentLang);

// Default values
const pageTitle = title || text(siteTexts, 'meta.home.title');
const pageDescription = description || text(siteTexts, 'meta.home.description');
const pageImage = imageUrl || 'https://snack.yummiespromociones.com/snacksyummies/graphqlsocial.webp';
const pageUrl = canonicalUrl || `https://snacksyummies.com/${currentLang}`;

// Social media URLs
function urlFor(platform: string): string {
  return socialMedia.find((sm) => sm.platform.toLowerCase() === platform)?.url || '';
}
const facebookUrl = urlFor('facebook');
const instagramUrl = urlFor('instagram');
const twitterUrl = urlFor('twitter');
const locales: string[] = (config.supportedLocales as unknown as string[]) || [];

---
<!-- Primary Meta Tags -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={pageUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={pageUrl} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:image" content={pageImage} />
<meta property="og:locale" content={currentLang} />
{locales.map((lang: string) => (
  <meta property="og:locale:alternate" content={lang} />
))}

<!-- Image Optimization -->
<meta name="og:image:width" content="1200" />
<meta name="og:image:height" content="630" />
<meta name="og:image:alt" content={`Yummi Nuts - ${title || 'Delicious snacks from Central America'}`} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={pageUrl} />
<meta property="twitter:title" content={pageTitle} />
<meta property="twitter:description" content={pageDescription} />
<meta property="twitter:image" content={pageImage} />

<!-- Social Media Links -->
{facebookUrl && <link rel="me" href={facebookUrl} />}
{instagramUrl && <link rel="me" href={instagramUrl} />}
{twitterUrl && <link rel="me" href={twitterUrl} />}

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Yummi Nuts",
  "url": "https://yumminuts.com",
  "logo": "https://snack.yummiespromociones.com/snacksyummies/logo.webp",
  "sameAs": [
    facebookUrl,
    instagramUrl,
    urlFor('tiktok')
  ].filter(Boolean)
})}></script>

<!-- Breadcrumbs Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": currentLang === 'es' ? 'Inicio' : 'Home',
      "item": `https://yumminuts.com/${currentLang}`
    }
  ]
})}></script>

<!-- Additional Tags -->
<meta name="theme-color" content="#0A3D7E" />
<meta name="msapplication-TileColor" content="#0A3D7E" />
