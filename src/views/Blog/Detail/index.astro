---
import Layout from '../../../layouts/MainLayout.astro';
import { type Locale } from '../../../i18n/i18n';
import Breadcrumb from '../../../components/common/Breadcrumb/Breadcrumb.astro';
import BlogCard from '../../../components/blog/BlogCard.astro';
import BlogDetailSkeleton from '../../../components/blog/BlogDetailSkeleton.astro';
import { fade, slide } from 'astro:transitions';
import LazyImage from '../../../components/common/LazyImage.astro';
import type { BlogPost } from '../../../lib/blogPosts';
import {
  formatMarkdownHtml,
  promoteBlogQuestionsToH2,
  normalizeBlogHtmlContent,
  hasVisibleBlogContent,
} from '../../../components/blog/markdownFormat';

interface Props {
  blogPost: BlogPost;
  currentLang: Locale;
  allBlogPosts?: Array<{
    id: string;
    slug: string;
    title: string;
    summary: string;
    image: string;
    published_date: string;
  }>;
  isLoading?: boolean;
}

const { blogPost, currentLang, allBlogPosts = [], isLoading = false } = Astro.props;

const suggestedPosts = allBlogPosts
  .filter((post) => post.id !== blogPost.id)
  .slice(0, 4);

const readMoreTitle = currentLang === 'es' ? 'Otras Noticias' : 'Other News';
const pageTitle = blogPost.meta_title || blogPost.title;
const pageDescription = blogPost.meta_description || blogPost.summary || '';
const desktopImage = blogPost.banner || blogPost.preview || blogPost.image;
const mobileImage = blogPost.preview || blogPost.banner || blogPost.image;

const blogDetailClasses = {
  h2: 'font-heading text-2xl md:text-3xl font-bold text-black mt-10 mb-4',
  p: 'text-gray-700 mb-4 leading-relaxed',
  ul: 'list-disc pl-6 my-4 space-y-2 text-gray-700',
  li: 'text-gray-700 leading-relaxed',
  strong: 'font-bold text-black',
};

const normalizedContent = normalizeBlogHtmlContent(blogPost.content);
const formattedContent = hasVisibleBlogContent(normalizedContent)
  ? formatMarkdownHtml(promoteBlogQuestionsToH2(normalizedContent), blogDetailClasses)
  : '';
---

<Layout title={pageTitle} class="bg-white" description={pageDescription}>
  {blogPost.schema_json_ld && (
    <script
      slot="head"
      type="application/ld+json"
      set:html={JSON.stringify(blogPost.schema_json_ld)}
    />
  )}

  <div class="container mx-auto px-4 py-12 max-w-4xl">
    {isLoading ? (
      <BlogDetailSkeleton />
    ) : (
      <>
        <Breadcrumb bgColor="bg-white" textColor="text-gray-500" hoverColor="hover:text-primary" />
        <div class="w-full mx-auto my-6">
          <div class="mb-8">
            <h1
              class="font-heading md:text-4xl text-2xl font-bold mb-4"
              transition:name={`blog-title-${blogPost.id}`}
            >
              {blogPost.title}
            </h1>
          </div>

          <div
            class="blog-image-container w-full mb-8 rounded-lg overflow-hidden text-center flex justify-center"
            transition:animate={slide({ duration: '0.3s' })}
          >
            <LazyImage
              src={mobileImage}
              alt={blogPost.title}
              class="w-full object-cover mx-auto md:hidden"
              transition:name={`blog-image-${blogPost.id}`}
              loading="lazy"
            />
            <LazyImage
              src={desktopImage}
              alt={blogPost.title}
              class="hidden md:block md:w-[500px] w-full object-cover mx-auto"
              transition:name={`blog-image-${blogPost.id}`}
              loading="lazy"
            />
          </div>

          {formattedContent && (
            <div
              class="blog-content max-w-none my-8 text-md md:text-lg"
              transition:animate={fade({ duration: '0.5s' })}
              set:html={formattedContent}
            />
          )}
        </div>

        {suggestedPosts.length > 0 && (
          <section class="mt-16 mb-12" transition:animate={fade({ duration: '0.7s' })}>
            <h2 class="text-black font-heading text-2xl md:text-5xl font-bold text-left mb-8">
              {readMoreTitle}
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 mx-auto max-w-7xl">
              {suggestedPosts.map((post) => (
                <BlogCard
                  image={post.image}
                  title={post.title}
                  id={post.id}
                  slug={post.slug || post.id}
                />
              ))}
            </div>
          </section>
        )}
      </>
    )}
  </div>
</Layout>

<style>
.animate-zoom {
  animation: zoom 15s linear infinite;
}
@keyframes zoom {
  0% { transform: scale(1); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}
