---
import Layout from '../../../layouts/MainLayout.astro';
import { type Locale } from '../../../i18n/i18n';
import Breadcrumb from '../../../components/common/Breadcrumb/Breadcrumb.astro';
import BlogCard from '../../../components/blog/BlogCard.astro';
import BlogDetailSkeleton from '../../../components/blog/BlogDetailSkeleton.astro';
import { fade } from 'astro:transitions';
import LazyImage from '../../../components/common/LazyImage.astro';
import type { BlogPost } from '../../../lib/blogPosts';
import {
  formatMarkdownHtml,
  promoteBlogQuestionsToH2,
  normalizeBlogHtmlContent,
  hasVisibleBlogContent,
} from '../../../components/blog/markdownFormat';

interface Props {
  blogPost: BlogPost;
  currentLang: Locale;
  allBlogPosts?: Array<{
    id: string;
    slug: string;
    title: string;
    summary: string;
    image: string;
    published_date: string;
  }>;
  isLoading?: boolean;
}

const { blogPost, currentLang, allBlogPosts = [], isLoading = false } = Astro.props;

const suggestedPosts = allBlogPosts
  .filter((post) => {
    const postSlug = post.slug || post.id;
    const currentSlug = blogPost.slug || blogPost.id;
    return postSlug !== currentSlug;
  })
  .slice(0, 4);

const readMoreTitle = currentLang === 'es' ? 'Otras Noticias' : 'Other News';
const pageTitle = blogPost.meta_title || blogPost.title;
const pageDescription = blogPost.meta_description || blogPost.summary || '';
const desktopImage = blogPost.banner || blogPost.preview || blogPost.image;
const mobileImage = blogPost.preview || blogPost.banner || blogPost.image;
const bannerImages = blogPost.bannerImages ?? [];
const carouselSlides = bannerImages.length
  ? bannerImages.map((src) => ({
      desktop: src,
      mobile: bannerImages.length === 1 ? mobileImage : src,
    }))
  : [{ desktop: desktopImage, mobile: mobileImage }];
const hasMultipleSlides = carouselSlides.length > 1;
const prevLabel = currentLang === 'es' ? 'Anterior' : 'Previous';
const nextLabel = currentLang === 'es' ? 'Siguiente' : 'Next';

const blogDetailClasses = {
  h2: 'font-heading text-2xl md:text-3xl font-bold text-black mt-10 mb-4',
  p: 'text-gray-700 mb-4 leading-relaxed',
  ul: 'list-disc pl-6 my-4 space-y-2 text-gray-700',
  li: 'text-gray-700 leading-relaxed',
  strong: 'font-bold text-black',
};

const normalizedContent = normalizeBlogHtmlContent(blogPost.content);
const formattedContent = hasVisibleBlogContent(normalizedContent)
  ? formatMarkdownHtml(promoteBlogQuestionsToH2(normalizedContent), blogDetailClasses)
  : '';
---

<Layout title={pageTitle} class="bg-white" description={pageDescription}>
  {blogPost.schema_json_ld && (
    <script
      slot="head"
      type="application/ld+json"
      set:html={JSON.stringify(blogPost.schema_json_ld)}
    />
  )}

  <div class="container mx-auto px-4 py-12 max-w-4xl">
    {isLoading ? (
      <BlogDetailSkeleton />
    ) : (
      <>
        <Breadcrumb bgColor="bg-white" textColor="text-gray-500" hoverColor="hover:text-primary" />
        <div class="w-full mx-auto my-6">
          <div class="mb-8">
            <h1
              class="font-heading md:text-4xl text-2xl font-bold mb-4"
              transition:name={`blog-title-${blogPost.id}`}
            >
              {blogPost.title}
            </h1>
          </div>

          <div class="blog-image-carousel relative w-full md:max-w-[680px] mx-auto mb-8" data-blog-image-carousel>
            <div class="blog-image-track flex overflow-x-auto snap-x snap-mandatory scroll-smooth rounded-lg" data-blog-track>
              {carouselSlides.map((slide) => (
                <div class="blog-image-slide snap-center shrink-0 w-full">
                  <LazyImage
                    src={slide.mobile}
                    alt={blogPost.title}
                    class="w-full object-cover md:hidden"
                    loading="lazy"
                  />
                  <LazyImage
                    src={slide.desktop}
                    alt={blogPost.title}
                    class="hidden md:block w-full object-cover"
                    loading="lazy"
                  />
                </div>
              ))}
            </div>
            {hasMultipleSlides && (
              <>
                <button type="button" class="blog-image-nav blog-image-nav-prev" data-blog-prev aria-label={prevLabel}>❮</button>
                <button type="button" class="blog-image-nav blog-image-nav-next" data-blog-next aria-label={nextLabel}>❯</button>
                <div class="flex justify-center gap-2 mt-3">
                  {carouselSlides.map((_, index) => (
                    <button
                      type="button"
                      class:list={['blog-image-dot', { 'is-active': index === 0 }]}
                      data-blog-dot={index}
                      aria-label={`${index + 1}`}
                    />
                  ))}
                </div>
              </>
            )}
          </div>

          {formattedContent && (
            <div
              class="blog-content max-w-none my-8 text-md md:text-lg"
              transition:animate={fade({ duration: '0.5s' })}
              set:html={formattedContent}
            />
          )}
        </div>

        {suggestedPosts.length > 0 && (
          <section class="mt-16 mb-12" transition:animate={fade({ duration: '0.7s' })}>
            <h2 class="text-black font-heading text-2xl md:text-5xl font-bold text-left mb-8">
              {readMoreTitle}
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 mx-auto max-w-7xl">
              {suggestedPosts.map((post) => (
                <BlogCard
                  image={post.image}
                  title={post.title}
                  id={post.id}
                  slug={post.slug || post.id}
                  currentLang={currentLang}
                />
              ))}
            </div>
          </section>
        )}
      </>
    )}
  </div>
</Layout>

<script>
  function initBlogImageCarousels() {
    document.querySelectorAll('[data-blog-image-carousel]').forEach((root) => {
      if (!(root instanceof HTMLElement) || root.dataset.blogCarouselBound === '1') return;
      const track = root.querySelector('[data-blog-track]');
      const prev = root.querySelector('[data-blog-prev]');
      const next = root.querySelector('[data-blog-next]');
      if (!(track instanceof HTMLElement)) return;

      root.dataset.blogCarouselBound = '1';
      const dots = Array.from(root.querySelectorAll('[data-blog-dot]'));
      let index = 0;

      const setActive = (nextIndex: number) => {
        const count = track.children.length;
        if (!count) return;
        index = (nextIndex + count) % count;
        track.scrollTo({ left: index * track.clientWidth, behavior: 'smooth' });
        dots.forEach((dot, dotIndex) => {
          dot.classList.toggle('is-active', dotIndex === index);
        });
      };

      prev?.addEventListener('click', () => setActive(index - 1));
      next?.addEventListener('click', () => setActive(index + 1));
      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          setActive(Number(dot.getAttribute('data-blog-dot')) || 0);
        });
      });

      track.addEventListener('scroll', () => {
        const width = track.clientWidth || 1;
        const nextIndex = Math.round(track.scrollLeft / width);
        if (nextIndex === index) return;
        index = nextIndex;
        dots.forEach((dot, dotIndex) => {
          dot.classList.toggle('is-active', dotIndex === index);
        });
      }, { passive: true });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlogImageCarousels);
  } else {
    initBlogImageCarousels();
  }
  document.addEventListener('astro:page-load', initBlogImageCarousels);
  document.addEventListener('astro:after-swap', initBlogImageCarousels);
</script>

<style>
  .blog-image-track {
    scrollbar-width: none;
  }

  .blog-image-track::-webkit-scrollbar {
    display: none;
  }

  .blog-image-nav {
    position: absolute;
    top: 42%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.375rem;
    background: #385cad;
    color: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.2);
  }

  .blog-image-nav-prev {
    left: 0.5rem;
  }

  .blog-image-nav-next {
    right: 0.5rem;
  }

  .blog-image-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: #b5d3ed;
  }

  .blog-image-dot.is-active {
    background: #385cad;
  }

.animate-zoom {
  animation: zoom 15s linear infinite;
}
@keyframes zoom {
  0% { transform: scale(1); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}
  .hero-container {
    width: 100%;
    max-height: 300px;
    overflow: hidden;
    margin-bottom: 2rem;
  }
  
  .hero-image {
    width: 100%;
    height: 300px;
    background-image: url('https://snack.yummiespromociones.com/snacksyummies/bgondas.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  
  @media (max-width: 768px) {
    .hero-image {
      height: 200px;
    }
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  .max-w-3xl {
    max-width: 800px;
  }
  
  .mb-8 {
    margin-bottom: 2rem;
  }
  
  .text-sm {
    font-size: 0.875rem;
  }
  
  .text-gray-500 {
    color: #64748b;
  }
  
  .mb-2 {
    margin-bottom: 0.5rem;
  }
  
  .text-3xl {
    font-size: 1.875rem;
  }
  
  .font-bold {
    font-weight: 700;
  }
  
  .mb-4 {
    margin-bottom: 1rem;
  }
  
  .text-gray-600 {
    color: #4b5563;
  }
  
  .mb-6 {
    margin-bottom: 1.5rem;
  }
  
  .relative {
    position: relative;
  }
  
  .h-96 {
    height: 24rem;
  }
  
  .rounded-lg {
    border-radius: 0.5rem;
  }
  
  .overflow-hidden {
    overflow: hidden;
  }
  
  .w-full {
    width: 100%;
  }
  
  .h-full {
    height: 100%;
  }
  
  .object-cover {
    object-fit: cover;
  }
  
  .prose {
    line-height: 1.6;
  }
  
