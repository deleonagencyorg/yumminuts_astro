---
// src/views/Recipes/index.astro
import { getLocale } from '../../i18n/i18n';
import './styles.css';
import RecipeCard from '../../components/recipes/RecipeCard.astro';
import Breadcrumb from '../../components/common/Breadcrumb/Breadcrumb.astro';

interface Recipe {
  id: string;
  title: string;
  image?: string;
  preparation_time: number;
  type?: string;
}

const currentLang = getLocale();

// Get all recipe files with correct Vite glob typing
const recipeModules = import.meta.glob<{default: Recipe}>('../../locales/*/recipes/*.json');
const allRecipes: Recipe[] = [];

// Process each file
for (const path in recipeModules) {
  // Path format: ../../locales/es/recipes/file.json
  const pathParts = path.split('/');
  const lang = pathParts[pathParts.length - 3]; // Get 'es' or 'en' from path
  if (lang === currentLang) {
    const module = await recipeModules[path]();
    allRecipes.push(module.default);
  }
}

// Shared translations
const noRecipesText = currentLang === 'es' 
  ? 'No hay recetas disponibles en este momento.' 
  : 'No recipes available at this time.';
const noFilterResultsText = currentLang === 'es'
  ? 'No se encontraron resultados para la selección'
  : 'No results found for the selection';

// Filter labels (keys must be in EN, labels localized)
const filterLabels = currentLang === 'es'
  ? {
      all: 'Todas',
      breakfast: 'Desayunos',
      snacks: 'Snack Energéticos',
      lunch: 'Almuerzos',
      dinner: 'Cenas'
    }
  : {
      all: 'All',
      breakfast: 'Breakfast',
      snacks: 'Energy Snacks',
      lunch: 'Lunch',
      dinner: 'Dinner'
    };

const filterOptions = [
  { key: 'all', label: filterLabels.all },
  { key: 'breakfast', label: filterLabels.breakfast },
  { key: 'snacks', label: filterLabels.snacks },
  { key: 'lunch', label: filterLabels.lunch },
  { key: 'dinner', label: filterLabels.dinner },
];

const loadMoreLabel = currentLang === 'es' ? 'Cargar más' : 'Load more';
const filterAriaLabel = currentLang === 'es' ? 'Filtrar recetas' : 'Filter recipes';

// Normaliza la categoría de receta.
// Nota: en los JSON se usa "type" para cosas como el tipo de media (p.ej. "image").
// Para los filtros debemos priorizar la propiedad "category" si existe.
function normalizeType(r: Recipe): string {
  const rawCategory = String((r as any).category || '').toLowerCase().trim();
  const rawType = String((r as any).type || '').toLowerCase().trim();

  // Prefer category over type
  const raw = rawCategory || rawType;

  // Breakfast
  if (['breakfast', 'desayuno', 'desayunos'].includes(raw)) return 'breakfast';
  // Snacks / Energy snacks (map brunch items here for this project taxonomy)
  if ([
    'snack', 'snacks', 'snack energeticos', 'snack energético', 'snack energéticos', 'snack-energeticos', 'energy snacks', 'brunch'
  ].includes(raw)) return 'snacks';
  // Lunch
  if (['lunch', 'almuerzo', 'almuerzos'].includes(raw)) return 'lunch';
  // Dinner
  if (['dinner', 'cena', 'cenas'].includes(raw)) return 'dinner';

  return 'other';
}
---
<div class="-mt-px -mb-px overflow-hidden bg-white">
  
  <div class="container mx-auto px-4 ">
    <div class="pt-4">
      <Breadcrumb bgColor="bg-transparent" textColor="text-primary" hoverColor="hover:text-primary" />
    </div>

    <!-- Filtro mobile: selector -->
    <div class="md:hidden mb-6 w-full">
      <div class="recipes-filter-select-wrap relative w-full">
        <select
          id="recipeFilterSelect"
          class="recipes-page-filter-select w-full text-left px-4 py-2 pr-10 rounded-md bg-secondary text-primary font-bold border border-white cursor-pointer"
          aria-label={filterAriaLabel}
        >
          {filterOptions.map((option) => (
            <option value={option.key}>{option.label}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Filtros desktop: botones -->
    <div id="recipeFilters" class="hidden md:grid md:grid-cols-5 md:gap-4 mb-8">
      {filterOptions.map((option) => (
        <button type="button" class="filter-btn w-full text-center px-6 py-2 rounded-md bg-secondary text-primary font-bold hover:text-primary hover:bg-secondary hover:opacity-100 active:text-primary active:bg-secondary transition-colors border border-white" data-filter={option.key}>{option.label}</button>
      ))}
    </div>

    {allRecipes.length === 0 ? (
      <p class="text-center text-gray-500">{noRecipesText}</p>
    ) : (
      <div id="recipesGrid" class="w-full mx-auto grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-10 mt-12" transition:animate="slide">
        {allRecipes.map((recipe: Recipe) => (
          <div class="recipe-card" data-type={normalizeType(recipe)}>
            <RecipeCard
              image={recipe.image || '/images/recipes/placeholder.jpg'}
              title={recipe.title}
              time={`${recipe.preparation_time}MIN`}
              id={recipe.id}
              textColor="text-white"
              iconColor="text-white"
            />
          </div>
        ))}
      </div>
      <!-- No results message for filters -->
      <div id="noResults" class="hidden mt-6 items-center justify-center h-48 md:h-64">
        <span class="text-white text-lg md:text-xl font-semibold">{noFilterResultsText}</span>
      </div>
      <!-- Cargar más -->
      <div id="recipesLoadMoreWrap" class="mt-8 mb-10 w-full hidden">
        <button
          type="button"
          id="recipesLoadMoreBtn"
          class="filter-btn w-full text-center px-4 py-3 rounded-md bg-secondary text-primary font-bold hover:text-primary hover:bg-secondary hover:opacity-100 transition-colors border border-white"
          data-mobile-batch="6"
          data-desktop-batch="8"
        >
          {loadMoreLabel}
        </button>
      </div>
    )}
  </div>
</div>

<script is:inline>
  (function() {
    'use strict';
    
    function initRecipesPage() {
      const filtersContainer = document.getElementById('recipeFilters');
      const filterSelect = document.getElementById('recipeFilterSelect');
      const filterButtons = Array.from(filtersContainer?.querySelectorAll('.filter-btn') || []);
      const cards = Array.from(document.querySelectorAll('#recipesGrid .recipe-card'));
      const noResultsEl = document.getElementById('noResults');
      const loadMoreWrap = document.getElementById('recipesLoadMoreWrap');
      const loadMoreBtn = document.getElementById('recipesLoadMoreBtn');

      if (cards.length === 0) {
        return;
      }

      const mobileBatch = Number(loadMoreBtn?.dataset.mobileBatch) || 6;
      const desktopBatch = Number(loadMoreBtn?.dataset.desktopBatch) || 8;
      const isMobile = () => window.matchMedia('(max-width: 767px)').matches;
      const getBatchSize = () => (isMobile() ? mobileBatch : desktopBatch);

      let currentFilter = 'all';
      let revealedCount = 0;

      function hideAll() {
        cards.forEach((c) => (c.style.display = 'none'));
      }

      function getMatchingCards(filter) {
        return cards.filter((card) => {
          const type = (card.dataset.type || 'other').toLowerCase();
          return filter === 'all' || type === filter;
        });
      }

      function updateLoadMoreVisibility() {
        if (!loadMoreWrap) return;
        const matching = getMatchingCards(currentFilter);
        const hasMore = revealedCount < matching.length;
        loadMoreWrap.classList.toggle('hidden', !hasMore);
      }

      function revealNextPage() {
        const matching = getMatchingCards(currentFilter);
        const nextBatch = matching.slice(revealedCount, revealedCount + getBatchSize());
        nextBatch.forEach((card) => (card.style.display = ''));
        revealedCount += nextBatch.length;

        const anyVisible = matching.length > 0;
        if (noResultsEl) {
          if (anyVisible) {
            noResultsEl.classList.add('hidden');
            noResultsEl.classList.remove('flex');
          } else {
            noResultsEl.classList.remove('hidden');
            noResultsEl.classList.add('flex');
          }
        }

        updateLoadMoreVisibility();
      }

      function applyFilter(filter) {
        currentFilter = filter;
        revealedCount = 0;
        hideAll();
        revealNextPage();
      }

      function setActiveButton(btn) {
        filterButtons.forEach((b) => {
          b.classList.remove('bg-secondary', 'opacity-40', 'opacity-50', 'text-primary');
          b.classList.add('text-primary');
        });
        btn.classList.add('bg-secondary', 'text-primary');
        filterButtons.forEach((b) => {
          if (b !== btn) b.classList.add('opacity-40');
        });
      }

      function setActiveFilter(filter) {
        currentFilter = filter || 'all';

        if (filterSelect instanceof HTMLSelectElement && filterSelect.value !== currentFilter) {
          filterSelect.value = currentFilter;
        }

        const activeBtn = filterButtons.find((b) => b.getAttribute('data-filter') === currentFilter);
        if (activeBtn) {
          setActiveButton(activeBtn);
        }

        applyFilter(currentFilter);
      }

      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          setActiveFilter(btn.getAttribute('data-filter') || 'all');
        });
      });

      if (filterSelect instanceof HTMLSelectElement) {
        filterSelect.addEventListener('change', () => {
          setActiveFilter(filterSelect.value || 'all');
        });
      }

      if (loadMoreBtn instanceof HTMLButtonElement) {
        loadMoreBtn.addEventListener('click', () => {
          revealNextPage();
        });
      }

      setActiveFilter('all');

      window.addEventListener('resize', () => {
        const matching = getMatchingCards(currentFilter);
        if (revealedCount < getBatchSize() && matching.length > 0) {
          revealedCount = 0;
          hideAll();
          revealNextPage();
        } else {
          updateLoadMoreVisibility();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRecipesPage);
    } else {
      initRecipesPage();
    }
    
    document.addEventListener('astro:page-load', initRecipesPage);
    document.addEventListener('astro:after-swap', initRecipesPage);
  })();
</script>

<style>
  .recipes-page-filter-select {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23385cad' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpath d='M19 9l-7 7-7-7'/%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    background-size: 1.25rem;
  }

  .recipes-page-filter-select::-ms-expand {
    display: none;
  }

  .recipes-page-filter-select:focus {
    outline: none;
    box-shadow: 0 0 0 2px var(--color-brown, #8b4513);
  }

  #recipeFilters .filter-btn.bg-brown {
    /* nothing else, class toggles handle colors */
  }
</style>
