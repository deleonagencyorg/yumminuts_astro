---
import MainLayout from '../../layouts/MainLayout.astro';
import juradosData from '../../locales/es/jurados.json';

export interface Props {
  lang?: string;
  headerColor?: {
    backgroundColor: string;
    textColor: string;
  };
}

const { headerColor } = Astro.props;
---

<MainLayout
  title={juradosData.meta.title}
  description={juradosData.meta.description}
  headerColors={headerColor}
>
  <section class="py-16 bg-blue h-screen w-full">
    <h1 class="text-5xl font-bold text-center mb-8">{juradosData.title}</h1>
    <p class="text-xl text-center mb-12">{juradosData.description}</p>
  </section>
</MainLayout>
